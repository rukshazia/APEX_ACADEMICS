# =====================================================================
# APEX ACADEMICS: STUDENT SUCCESS & CAMPUS ANALYTICS PLATFORM
# Environment Configuration Template
# =====================================================================

# Application Environment (development / production)
APP_ENV=development

# Primary Relational Database
# Local development uses persistent SQLite: sqlite:///./campus_analytics.db
# Production uses PostgreSQL: postgresql://postgres:password@localhost:5432/campus_analytics
DATABASE_URL=sqlite:///./campus_analytics.db

# Security & Authentication
JWT_SECRET=super-secret-development-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production Database & Authentication (Supabase - Optional)
# If left blank, the application uses local persistent database & local auth
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_JWT_SECRET=

# AI Provider Integration (OpenAI - Optional)
# If left blank, the platform automatically activates its deterministic local analytics engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Institutional Email Delivery (SMTP - Optional)
# If left blank, direct in-app notification routing is utilized
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
